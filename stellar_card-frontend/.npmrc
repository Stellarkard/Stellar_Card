# The Storybook 10 upgrade left @storybook/addon-essentials pinned at 8.6.14
# (its later majors were folded into Storybook core / split into separate
# packages), which peer-depends on storybook@^8. That makes a plain
# `npm install` / `npm ci` fail with ERESOLVE on a clean checkout — which is
# almost certainly why this package was never wired into CI (see
# .github/workflows/e2e.yml): the very first install step would have
# failed every time.
#
# legacy-peer-deps mirrors npm 6's peer-dependency resolution (report
# conflicts as warnings instead of hard errors) so installs succeed while
# the Storybook addon versions get reconciled separately. Safe here because
# the conflicting peer is a dev-only Storybook addon, not a runtime dependency.
legacy-peer-deps=true
