{
  "openapi": "3.0.0",
  "info": {
    "title": "Stellar Card Backend API",
    "description": "API endpoints for the Stellar Card platform",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.stellar-card.example.com",
      "description": "Production server"
    }
  ],
  "paths": {
    "/v1/agent/claim": {
      "post": {
        "summary": "Claim an agent code",
        "description": "Exchange a dashboard-minted code for an API key",
        "tags": ["Agent"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string",
                    "description": "The claim code issued by the dashboard"
                  }
                },
                "required": ["code"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "API key generated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "api_key": {
                      "type": "string",
                      "description": "The generated API key for future requests"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid or expired code"
          }
        }
      }
    },
    "/v1/orders": {
      "post": {
        "summary": "Create a payment order",
        "description": "Create a new card top-up order",
        "tags": ["Orders"],
        "security": [
          {
            "apiKey": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "amount": {
                    "type": "number",
                    "description": "Order amount in USD"
                  },
                  "currency": {
                    "type": "string",
                    "enum": ["USD", "XLM", "USDC"],
                    "description": "Payment currency"
                  }
                },
                "required": ["amount", "currency"]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Order created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "order_id": {
                      "type": "string",
                      "description": "Unique order identifier"
                    },
                    "status": {
                      "type": "string",
                      "enum": ["pending", "processing", "completed"],
                      "description": "Current order status"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - invalid or missing API key"
          },
          "400": {
            "description": "Bad request - invalid parameters"
          },
          "429": {
            "description": "Rate limit exceeded - default 60 order creations per hour per API key, overridable per key via rate_limit_rpm. Applies before request body validation, so malformed requests count against the budget too. Includes RateLimit (IETF draft-7) and Retry-After response headers.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "enum": ["rate_limit_exceeded"]
                    },
                    "message": {
                      "type": "string",
                      "description": "Human-readable message pointing at the per-key rate_limit_rpm setting"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "List orders",
        "description": "Retrieve paginated list of orders for the authenticated agent",
        "tags": ["Orders"],
        "security": [
          {
            "apiKey": []
          }
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 50
            },
            "description": "Number of orders to return"
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 0
            },
            "description": "Number of orders to skip"
          }
        ],
        "responses": {
          "200": {
            "description": "List of orders",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "orders": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "order_id": {
                            "type": "string"
                          },
                          "amount": {
                            "type": "number"
                          },
                          "status": {
                            "type": "string"
                          },
                          "created_at": {
                            "type": "string",
                            "format": "date-time"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/v1/agent/status": {
      "get": {
        "summary": "Get agent status",
        "description": "Retrieve authentication status and configuration for the authenticated agent",
        "tags": ["Agent"],
        "security": [
          {
            "apiKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "Agent status",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "authenticated": {
                      "type": "boolean"
                    },
                    "agent_id": {
                      "type": "string"
                    },
                    "created_at": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "Dashboard login",
        "description": "Authenticate as an operator with email and password",
        "tags": ["Authentication"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string",
                    "format": "password"
                  }
                },
                "required": ["email", "password"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful - session established",
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "type": "string",
                  "example": "session_id=abcd1234; Path=/; HttpOnly"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials"
          }
        }
      }
    },
    "/dashboard/platform/accounts": {
      "get": {
        "summary": "List platform accounts",
        "description": "Retrieve all accounts (platform-owner only)",
        "tags": ["Dashboard"],
        "security": [
          {
            "sessionAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "List of accounts",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "accounts": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "account_id": {
                            "type": "string"
                          },
                          "name": {
                            "type": "string"
                          },
                          "email": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden - requires platform owner role"
          }
        }
      }
    },
    "/vcc-callback": {
      "post": {
        "summary": "VCC fulfillment callback",
        "description": "Webhook endpoint for VCC provider status updates",
        "tags": ["Webhooks"],
        "security": [
          {
            "hmacSignature": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "order_id": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string",
                    "enum": ["fulfilled", "failed", "expired"]
                  },
                  "card_number": {
                    "type": "string",
                    "description": "Last 4 digits of the virtual card (masked)"
                  }
                },
                "required": ["order_id", "status"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Callback processed successfully"
          },
          "401": {
            "description": "Invalid HMAC signature"
          },
          "400": {
            "description": "Invalid callback data"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "apiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Api-Key",
        "description": "Agent API key"
      },
      "sessionAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "session_id",
        "description": "Operator session cookie"
      },
      "hmacSignature": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Signature",
        "description": "HMAC-SHA256 signature of the request body"
      }
    }
  },
  "tags": [
    {
      "name": "Orders",
      "description": "Card top-up order operations"
    },
    {
      "name": "Agent",
      "description": "Agent authentication and status"
    },
    {
      "name": "Authentication",
      "description": "Operator authentication"
    },
    {
      "name": "Dashboard",
      "description": "Dashboard operator endpoints"
    },
    {
      "name": "Webhooks",
      "description": "Webhook endpoints for external services"
    }
  ]
}
